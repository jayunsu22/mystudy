            "이지팩터": "={{ $json.new_ease_factor }}",
            "간격일수": "={{ $json.new_interval_days }}",
            "다음복습일": "={{ $json.new_next_review_date }}",
            "복습횟수": "={{ $json.new_times_reviewed }}",
            "최근결과": "={{ $json.new_last_result }}"
          }
        },
        "options": {}
      },
      "id": "at_review_update",
      "name": "Airtable: SM-2 스케줄 갱신",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1200, 480],
      "credentials": { "airtableTokenApi": { "id": "PLACEHOLDER", "name": "Airtable Personal Access Token account 2" } }
    },
    {
      "parameters": {
        "operation": "create",
        "base": { "value": "appnIQ0eb9IPrQGCt", "mode": "id" },
        "table": { "value": "복습기록", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "일시": "={{ $now.toISO() }}",
            "카드ID": "={{ $json.card_id }}",
            "모드": "={{ $('3. POST 답변 채점 Webhook').first().json.body.mode || 'VOICE' }}",
            "단계": "={{ $json.phase }}",
            "사용자답변": "={{ $json.user_answer }}",
            "정답여부": "={{ $json.correct }}",
            "점수": "={{ $json.score }}",
            "피드백": "={{ $json.feedback_ko }}",
            "발음팁": "={{ $json.pronunciation_tip }}"
          }
        },
        "options": {}
      },
      "id": "at_review_log",
      "name": "Airtable: 복습기록 생성",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [950, 720],
      "credentials": { "airtableTokenApi": { "id": "PLACEHOLDER", "name": "Airtable Personal Access Token account 2" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { correct: $json.correct, score: $json.score, feedback_ko: $json.feedback_ko, pronunciation_tip: $json.pronunciation_tip, new_ease_factor: $json.new_ease_factor, new_interval_days: $json.new_interval_days, new_next_review_date: $json.new_next_review_date, new_times_reviewed: $json.new_times_reviewed } }}"
      },
      "id": "resp_grade",
      "name": "응답 (채점)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [950, 620],
      "notesInFlow": true,
      "notes": "Airtable 기록(위/아래 브랜치)을 기다리지 않고 code_grade_calc 결과로 바로 응답 — 음성모드 흐름이 끊기지 않게."
    },


        "jsCode": "const materials = $('Airtable: 챕터용 학습자료 조회').all();\nconst cards = $('Airtable: 챕터용 카드 조회').all();\n\nconst chapters = materials\n  .map(m => ({\n    id: m.id,\n    title: m.json.제목,\n    card_count: cards.filter(c => (c.json.자료 || []).includes(m.id)).length\n  }))\n  .filter(ch => ch.card_count > 0);\n\nchapters.sort((a, b) => a.title.localeCompare(b.title, 'ko'));\nreturn [{ json: { chapters } }];"

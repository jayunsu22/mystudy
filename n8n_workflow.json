        "jsCode": "const materials = $('Airtable: 학습자료 전체 조회').all();\nconst cards = $('Airtable: 카드 전체 조회').all();\nconst reviews = $('Airtable: 복습기록 전체 조회').all();\n\nconst lastReviewByCardId = {};\nreviews.forEach(r => {\n  const cid = r.json.카드ID;\n  if (cid && !lastReviewByCardId[cid]) lastReviewByCardId[cid] = r.json.일시; // 이미 일시 내림차순 정렬됨\n});\n\nconst result = materials.map(m => {\n  const myCards = cards.filter(c => (c.json.자료 || []).includes(m.id));\n  const cardIds = myCards.map(c => c.id);\n  const totalReviews = myCards.reduce((sum, c) => sum + (c.json.복습횟수 || 0), 0);\n  let lastReviewed = null;\n  cardIds.forEach(cid => {\n    const d = lastReviewByCardId[cid];\n    if (d && (!lastReviewed || d > lastReviewed)) lastReviewed = d;\n  });\n  return {\n    material_id: m.id,\n    title: m.json.제목,\n    card_count: myCards.length,\n    new_count: myCards.filter(c => c.json.단계 === '신규').length,\n    total_reviews: totalReviews,\n    last_reviewed_date: lastReviewed ? lastReviewed.slice(0, 10) : null\n  };\n});\n\nreturn [{ json: { materials: result } }];"
      },

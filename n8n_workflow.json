        "table": { "value": "복습기록", "mode": "name" },
        "returnAll": true,
        "options": { "sort": { "property": [ { "field": "일시", "direction": "desc" } ] } }
      },
      "id": "at_reviews_list_for_stats",
      "name": "Airtable: 복습기록 전체 조회",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [450, 1250],

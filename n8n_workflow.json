    {
      "parameters": {
        "jsCode": "const body = $('8. POST 복습 완료(무채점) Webhook').first().json.body;\nconst ease = Number(body.ease_factor) || 2.5;\nconst interval = Number(body.interval_days) || 1;\nconst timesReviewed = Number(body.times_reviewed) || 0;\n\n// 채점 없이 항상 통과(quality=5)로 SM-2 계산\nlet newEase = ease + 0.1;\nnewEase = Math.max(1.3, Math.round(newEase * 100) / 100);\n\nconst newInterval = timesReviewed === 0 ? 1 : Math.round(interval * newEase);\nconst today = new Date();\nconst next = new Date(today);\nnext.setDate(next.getDate() + newInterval);\nconst nextReviewDate = next.toISOString().slice(0, 10);\n\nreturn [{ json: {\n  card_id: body.card_id,\n  new_ease_factor: newEase,\n  new_interval_days: newInterval,\n  new_next_review_date: nextReviewDate,\n  new_times_reviewed: timesReviewed + 1,\n  new_last_result: '정답'\n} }];"
      },

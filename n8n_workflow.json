    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: `당신은 친절하지만 정확한 학습 코치입니다. 아래 문제에 대한 사용자의 답이 모범답안과 의미상 맞는지 판단하세요. 사용자의 답은 음성인식(STT) 결과이므로 발음이 부정확하면 이상하게 들릴 수 있습니다.\\n\\n문제: ${$json.body.question}\\n모범답안: ${$json.body.model_answer}\\n사용자 답변(음성인식 결과): ${$json.body.user_answer}\\n\\n판단 기준:\\n- 핵심 의미가 통하면 정답으로 처리하세요(철자/토씨가 완전히 같을 필요 없음).\\n- 음성인식 결과가 모범답안과 발음상 비슷하지만 다른 단어로 잘못 인식된 것 같다면, pronunciation_tip에 정확한 발음 팁을 한국어로 짧게 적어주세요(강세 위치 등). 문제 없어 보이면 pronunciation_tip은 빈 문자열로 두세요.\\n- 응답이 없거나 인식이 안 된 경우 오답으로 처리하고 feedback_ko에 '못 들었어요, 다시 말해볼까요?' 같은 안내를 주세요.\\n\\n아래 JSON 형식으로만 응답하세요 (다른 설명 없이):\\n{\"correct\": true 또는 false, \"score\": 0~100 사이 정수, \"feedback_ko\": \"20자 내외 한국어 피드백 한 문장\", \"pronunciation_tip\": \"발음 팁 또는 빈 문자열\"}` } ] } ] }) }}",
        "options": {}
      },
      "id": "ca53d7d7-826d-45cd-89e9-e80cb2933e70",
      "name": "Gemini: 채점",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        717952,
        534816
      ],
      "notesInFlow": true,
      "credentials": {
        "googlePalmApi": {
          "id": "DVT2g7GvXhSY4Y4b",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "notes": "Google AI Studio에서 발급한 Gemini API 키를 credentials 또는 URL의 key 쿼리파라미터에 연결하세요."
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet parsed = { correct: false, score: 0, feedback_ko: '', pronunciation_tip: '' };\ntry {\n  let text = raw.candidates[0].content.parts[0].text.trim();\n  text = text.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(text);\n} catch (e) {}\n\nconst body = $('3. POST 답변 채점 Webhook').first().json.body;\nconst phase = body.phase || '복습'; // '신규' | '복습'\nconst correct = !!parsed.correct;\nconst score = Number(parsed.score) || 0;\n\nconst result = {\n  card_id: body.card_id,\n  phase,\n  correct,\n  score,\n  feedback_ko: parsed.feedback_ko || (correct ? '정답이에요!' : '아쉬워요, 다시 확인해봐요.'),\n  pronunciation_tip: parsed.pronunciation_tip || '',\n  user_answer: body.user_answer || ''\n};\n\nif (phase === '복습') {\n  const ease = Number(body.ease_factor) || 2.5;\n  const interval = Number(body.interval_days) || 1;\n  const timesReviewed = Number(body.times_reviewed) || 0;\n\n  // score -> SM-2 quality(0~5) 대략 매핑\n  const q = score >= 90 ? 5 : score >= 75 ? 4 : score >= 60 ? 3 : score >= 40 ? 2 : score >= 20 ? 1 : 0;\n  let newEase = ease + (0.1 - (5 - q) * (0.08 + (5 - q) * 0.02));\n  newEase = Math.max(1.3, Math.round(newEase * 100) / 100);\n\n  let newInterval, nextReviewDate;\n  const today = new Date();\n  if (q < 3) {\n    // 오답(랩스): 짧게 다시 — 다음 복습 세션에 바로 재등장\n    newInterval = 1;\n    nextReviewDate = today.toISOString().slice(0, 10);\n  } else {\n    newInterval = timesReviewed === 0 ? 1 : Math.round(interval * newEase);\n    const next = new Date(today);\n    next.setDate(next.getDate() + newInterval);\n    nextReviewDate = next.toISOString().slice(0, 10);\n  }\n\n  result.new_ease_factor = newEase;\n  result.new_interval_days = newInterval;\n  result.new_next_review_date = nextReviewDate;\n  result.new_times_reviewed = timesReviewed + 1;\n  result.new_last_result = correct ? '정답' : '오답';\n}\n\nreturn [{ json: result }];"
      },
      "id": "31a1ec25-66bd-4b3b-a5b6-bbba644f7421",
      "name": "채점 파싱 + SM-2 계산",
      "type": "n8n-nodes-base.code",

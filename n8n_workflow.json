    {
      "parameters": {
        "jsCode": "const cards = $input.all().map(i => ({\n  id: i.json.id,\n  question: i.json.질문,\n  model_answer: i.json.모범답안,\n  hint: i.json.힌트 || '',\n  card_type: i.json.유형,\n  material_title: (i.json.자료명 && i.json.자료명[0]) || '',\n  ease_factor: i.json.이지팩터 || 2.5,\n  interval_days: i.json.간격일수 || 1,\n  times_reviewed: i.json.복습횟수 || 0\n}));\n// 오늘 새로 졸업한 카드와 예전부터 있던 카드를 섞기 위해 무작위 셔플\nfor (let idx = cards.length - 1; idx > 0; idx--) {\n  const j = Math.floor(Math.random() * (idx + 1));\n  [cards[idx], cards[j]] = [cards[j], cards[idx]];\n}\nreturn [{ json: { cards } }];"
      },
